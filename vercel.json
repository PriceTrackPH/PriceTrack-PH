{
  "crons": [
    {
      "path": "/api/admin-health?push=cron",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/*.js": {
      "regions": [
        "sin1"
      ]
    },
    "api/admin-backup.js": {
      "regions": [
        "sin1"
      ],
      "includeFiles": ".backup/website.zip",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/admin/monitoring",
      "destination": "/admin/health",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/shopee/:shopId/:productId",
      "destination": "/api/product-page?shopId=:shopId&productId=:productId"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/health",
      "destination": "/"
    },
    {
      "source": "/admin/affiliate",
      "destination": "/"
    },
    {
      "source": "/admin/ads",
      "destination": "/"
    },
    {
      "source": "/admin/collector",
      "destination": "/"
    },
    {
      "source": "/admin/store-scanner",
      "destination": "/"
    },
    {
      "source": "/admin/settings",
      "destination": "/"
    }
  ]
}
