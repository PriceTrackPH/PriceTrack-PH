{
  "manifest_version": 3,
  "name": "PriceTrack PH",
  "version": "1.0.5",
  "description": "Detect Shopee product variations immediately at page start, then save price history in the background.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://shopee.ph/*",
    "https://*.shopee.ph/*",
    "https://pricetrackph.com/*",
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PriceTrack PH",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://pricetrackph.com/admin/collector*"
      ],
      "js": [
        "admin-collector-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://shopee.ph/*",
        "https://*.shopee.ph/*"
      ],
      "js": [
        "shopee-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.ph/*",
        "https://*.shopee.ph/*"
      ],
      "js": [
        "collector-options.js",
        "store-scanner.js",
        "content.js",
        "notification-trigger.js",
        "completion-toast.js"
      ],
      "run_at": "document_start"
    }
  ]
}
